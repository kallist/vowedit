# Server-only settings. Mock is always available; no GPU or network required.
VOWEDIT_DATA_DIR=data
VOWEDIT_PROVIDER=mock
COMFYUI_BASE_URL=
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT_SECONDS=180
# Start the backend on loopback only, with one worker.
# RunningHub cloud generation is opt-in and may incur cost. No calls during CI.
# Use a saved, manually verified SD/SDXL inpainting workflow and exact model name.
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
RUNNINGHUB_CHECKPOINT=
RUNNINGHUB_TIMEOUT_SECONDS=180
