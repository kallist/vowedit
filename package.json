{
  "name": "vowedit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "extension:build": "node extension/build.mjs",
    "extension:typecheck": "tsc --noEmit -p extension/tsconfig.json",
    "extension:test": "vitest run --config extension/vitest.config.ts",
    "extension:e2e": "playwright test --config e2e-extension/playwright.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "0.1.33",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
